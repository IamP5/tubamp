# In-plugin update (docs/UPDATES.md). Included from the top-level CMakeLists.txt after the
# plugin target exists. Defines:
#   tubamp_update_sources        the update core and the fetcher, compiled into the plugin
#                                only when ON, and always into tubamp_update_tool
#   tubamp_update_plugin_sources the JUCE-side production environment (plugin/), plugin only
#   tubamp_update_include_dirs   what those sources need on the include path
#   tubamp_update_tool           the console test runner and release gate
#
# Trusted release keys are exactly the files src/update/keys/*.pub.pem. Test keys live in
# tests/update/fixtures and are compiled into tubamp_update_tool only.

set(tubamp_update_dir "${CMAKE_CURRENT_SOURCE_DIR}/src/update")
set(tubamp_update_tests_dir "${CMAKE_CURRENT_SOURCE_DIR}/tests/update")
set(tubamp_update_gen_dir "${CMAKE_CURRENT_BINARY_DIR}/update_generated")

file(GLOB tubamp_update_sources CONFIGURE_DEPENDS
    "${tubamp_update_dir}/*.cpp" "${tubamp_update_dir}/*.h"
    "${tubamp_update_dir}/detail/*.cpp" "${tubamp_update_dir}/detail/*.mm" "${tubamp_update_dir}/detail/*.h")
file(GLOB tubamp_update_plugin_sources CONFIGURE_DEPENDS "${tubamp_update_dir}/plugin/*.cpp")

# The fetcher's delegate is an Objective-C class, and class names are process-wide: the
# version in the name keeps two tubamp builds loaded in one host from colliding.
string(MAKE_C_IDENTIFIER "${PROJECT_VERSION}" tubamp_update_objc_version)
set_source_files_properties("${tubamp_update_dir}/detail/Fetch.mm" PROPERTIES
    COMPILE_OPTIONS "-fobjc-arc"
    COMPILE_DEFINITIONS "TUBAMP_FETCH_DELEGATE=TubampUpdateFetchDelegate_${tubamp_update_objc_version}")
set(tubamp_update_include_dirs
    "${tubamp_update_dir}"
    "${tubamp_update_gen_dir}"
    "${nam_dir}/Dependencies/nlohmann")

file(GLOB tubamp_update_release_keys CONFIGURE_DEPENDS "${tubamp_update_dir}/keys/*.pub.pem")
file(GLOB tubamp_update_fixture_keys CONFIGURE_DEPENDS "${tubamp_update_tests_dir}/fixtures/*.pub.pem")

function(tubamp_pem_body out file)
    file(READ "${file}" text)
    string(REGEX REPLACE ".*-----BEGIN PUBLIC KEY-----(.*)-----END PUBLIC KEY-----.*" "\\1" body "${text}")
    string(REGEX REPLACE "[ \t\r\n]" "" body "${body}")
    set(${out} "${body}" PARENT_SCOPE)
endfunction()

# Sets `out` to a description of everything wrong with a release key set, or to "".
function(tubamp_release_key_problems out keys fixtures min_count)
    set(problems "")
    list(LENGTH keys count)
    if(count LESS min_count)
        string(APPEND problems "  ${count} release key(s) in src/update/keys, at least ${min_count} needed "
                               "(see src/update/keys/README.md).\n")
    endif()
    foreach(key IN LISTS keys)
        file(READ "${key}" text)
        if(text MATCHES "PRIVATE KEY")
            string(APPEND problems "  ${key} holds a private key. Delete it from the repository now.\n")
        elseif(NOT text MATCHES "-----BEGIN PUBLIC KEY-----")
            string(APPEND problems "  ${key} is not a PEM public key.\n")
        endif()
        if(text MATCHES "TEST KEY")
            string(APPEND problems "  ${key} is marked as a test key.\n")
        endif()
        tubamp_pem_body(body "${key}")
        foreach(fixture IN LISTS fixtures)
            tubamp_pem_body(fixture_body "${fixture}")
            if(body STREQUAL fixture_body)
                string(APPEND problems "  ${key} is the test key ${fixture}.\n")
            endif()
        endforeach()
    endforeach()
    set(${out} "${problems}" PARENT_SCOPE)
endfunction()

# The guard must refuse the fixtures themselves and an empty set, or it guards nothing.
tubamp_release_key_problems(self_test_fixtures "${tubamp_update_fixture_keys}" "${tubamp_update_fixture_keys}" 0)
tubamp_release_key_problems(self_test_empty "" "" 2)
list(LENGTH tubamp_update_fixture_keys fixture_count)
if(fixture_count EQUAL 0 OR self_test_fixtures STREQUAL "" OR self_test_empty STREQUAL "")
    message(FATAL_ERROR "src/update/update.cmake: the release-key guard failed its self-test.")
endif()

if(TUBAMP_UPDATES)
    set(min_release_keys 2)
else()
    set(min_release_keys 0)
endif()
tubamp_release_key_problems(release_key_problems "${tubamp_update_release_keys}"
                            "${tubamp_update_fixture_keys}" ${min_release_keys})
if(NOT release_key_problems STREQUAL "")
    message(FATAL_ERROR "Release keys refused:\n${release_key_problems}"
                        "TUBAMP_UPDATES=ON needs the release key and the offline recovery key, and no test key.")
endif()

# One raw string literal per file. The runtime parses the PEM text itself, so the
# committed files are the only source of the trusted set and nothing can drift.
function(tubamp_write_text_table out_file type_decl files)
    list(LENGTH files count)
    set(content "// Generated by src/update/update.cmake. Do not edit.\n#pragma once\n#include <array>\n#include <string_view>\n")
    string(APPEND content "${type_decl}${count}> {{\n")
    foreach(f IN LISTS files)
        get_filename_component(name "${f}" NAME)
        file(READ "${f}" text)
        string(APPEND content "    { \"${name}\", R\"tubamp(${text})tubamp\" },\n")
    endforeach()
    string(APPEND content "}};\n")
    file(WRITE "${out_file}.tmp" "${content}")
    configure_file("${out_file}.tmp" "${out_file}" COPYONLY)
endfunction()

tubamp_write_text_table("${tubamp_update_gen_dir}/tubamp_update_release_keys.inc"
    "struct ReleaseKeyFile { std::string_view name, pem; };\ninline constexpr auto releaseKeyFiles = std::array<ReleaseKeyFile, "
    "${tubamp_update_release_keys}")

# The golden bridge contract is shared with the page: ui/src/bridge/update-contract.json.
file(GLOB tubamp_update_fixture_files CONFIGURE_DEPENDS
    "${tubamp_update_tests_dir}/fixtures/*.pub.pem"
    "${tubamp_update_tests_dir}/fixtures/*.signed"
    "${CMAKE_CURRENT_SOURCE_DIR}/ui/src/bridge/update-contract.json")
# Read at configure time, so an edit to any of them must re-run CMake.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${tubamp_update_fixture_files})
tubamp_write_text_table("${tubamp_update_gen_dir}/tubamp_update_fixtures.inc"
    "struct FixtureFile { std::string_view name, text; };\ninline constexpr auto fixtureFiles = std::array<FixtureFile, "
    "${tubamp_update_fixture_files}")

# The disk tests assemble tubamp.component fixtures around this universal module, sign
# them ad hoc and zip them with ditto, so they need no JUCE build.
add_library(tubamp_update_fixture_component MODULE "${tubamp_update_tests_dir}/fixture-component.c")
set_target_properties(tubamp_update_fixture_component PROPERTIES OSX_ARCHITECTURES "arm64;x86_64")

file(GLOB tubamp_update_test_sources CONFIGURE_DEPENDS "${tubamp_update_tests_dir}/*.cpp" "${tubamp_update_tests_dir}/*.h")
add_executable(tubamp_update_tool
    "${CMAKE_CURRENT_SOURCE_DIR}/tools/update/main.cpp"
    ${tubamp_update_test_sources}
    ${tubamp_update_sources})
target_include_directories(tubamp_update_tool PRIVATE ${tubamp_update_include_dirs} "${tubamp_update_tests_dir}")
target_compile_definitions(tubamp_update_tool PRIVATE
    TUBAMP_UPDATE_FIXTURE_EXECUTABLE="$<TARGET_FILE:tubamp_update_fixture_component>")
add_dependencies(tubamp_update_tool tubamp_update_fixture_component)
target_link_libraries(tubamp_update_tool PRIVATE
    "-framework Security"
    "-framework CoreFoundation"
    "-framework Foundation"
    z
    juce::juce_recommended_warning_flags)

# Each must-not-compile case is compiled twice: as written it must compile (the control),
# and with -DVIOLATE it must fail with the error its first line names.
file(GLOB tubamp_update_mnc_cases CONFIGURE_DEPENDS "${tubamp_update_tests_dir}/must-not-compile/*.cpp")
set(mnc_flags -std=c++20 -fsyntax-only "-I${tubamp_update_dir}" "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
if(CMAKE_OSX_SYSROOT)
    list(APPEND mnc_flags -isysroot "${CMAKE_OSX_SYSROOT}")
endif()
# "|" separates list items: a ";" inside a custom command argument does not survive.
string(REPLACE ";" "|" mnc_flags_arg "${mnc_flags}")
string(REPLACE ";" "|" mnc_cases_arg "${tubamp_update_mnc_cases}")
set(mnc_stamp "${tubamp_update_gen_dir}/must-not-compile.stamp")
add_custom_command(
    OUTPUT "${mnc_stamp}"
    COMMAND "${CMAKE_COMMAND}"
            "-DCXX=${CMAKE_CXX_COMPILER}"
            "-DFLAGS=${mnc_flags_arg}"
            "-DCASES=${mnc_cases_arg}"
            "-DSTAMP=${mnc_stamp}"
            -P "${tubamp_update_tests_dir}/must-not-compile.cmake"
    DEPENDS ${tubamp_update_mnc_cases} ${tubamp_update_sources} "${tubamp_update_tests_dir}/must-not-compile.cmake"
    COMMENT "Checking that the update types reject the must-not-compile cases"
    VERBATIM)
add_custom_target(tubamp_update_must_not_compile DEPENDS "${mnc_stamp}")
add_dependencies(tubamp_update_tool tubamp_update_must_not_compile)
